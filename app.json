{
  "expo": {
    "name": "Seatify",
    "slug": "seatify",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      
      "package": "com.muslimah.seatify"
      
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d5608e72-6076-4227-b76b-c73c1df40eb5"
      }
    }
  }
}
